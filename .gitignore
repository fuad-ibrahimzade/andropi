/android/app/release

# Widget Preview related
.widget_preview/

# AndroPI generated artifacts (rebuild with the steps in README.md)
/android/app/src/main/jniLibs/
/android/app/src/main/assets/agent.zip
/android/app/src/main/assets/agent.stamp
/agent/node_modules/
# Dev-only fallback so `flutter run` can boot the agent without a release bundle
/agent/host.mjs
__pycache__/

# JVM crash logs
hs_err_pid*.log

# Release outputs (APK/AAB, the Play Store bundle and the desktop archives)
/release/

